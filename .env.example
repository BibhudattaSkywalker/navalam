# Copy to .env. Do not commit .env.

# --- Database ---------------------------------------------------------------
# MongoDB connection string. Required in production.
# Leave empty in local development to use the embedded MongoDB stored in data/mongo.
MONGO_URI=mongodb://127.0.0.1:27017/nalvalam

# --- Server -----------------------------------------------------------------
# Port used by `npm start`. `npm run dev` uses Vite's port (5173).
PORT=3000
# Set to true when the app runs behind a reverse proxy (nginx, a load balancer).
TRUST_PROXY=false
# Defaults to true in production. Set false only if you serve over plain http.
# COOKIE_SECURE=true
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- First admin account ----------------------------------------------------
# Created only when the users collection is empty. Change the password before going live.
ADMIN_EMAIL=admin@nalvalam.local
ADMIN_PASSWORD=Nalvalam@2026

# --- Razorpay ---------------------------------------------------------------
# Leave blank until checkout should go live. While blank, the site uses the demo checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Separate frontend / admin hosting ----------------------------------------
# Comma-separated origins allowed to call the API with cookies (no trailing slash).
# CORS_ORIGINS=https://www.example.org,https://admin.example.org
# Host the API on a subdomain of the same site (api.example.org) and share the cookie:
# COOKIE_DOMAIN=.example.org
# Only if the API lives on a different site (e.g. *.onrender.com): COOKIE_SAMESITE=none
